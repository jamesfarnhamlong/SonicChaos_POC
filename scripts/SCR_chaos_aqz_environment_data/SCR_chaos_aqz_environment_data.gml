case SPR_sonic_death: return SPR_chaos_aqz_base_sonic_death;
case SPR_sonic_down: return SPR_chaos_aqz_base_sonic_down;
case SPR_sonic_falling: return SPR_chaos_aqz_base_sonic_falling;
case SPR_sonic_jump: return SPR_chaos_aqz_base_sonic_jump;
case SPR_sonic_run: return SPR_chaos_aqz_base_sonic_run;
case SPR_sonic_spin: return SPR_chaos_aqz_base_sonic_spin;
case SPR_sonic_spin_dash: return SPR_chaos_aqz_base_sonic_spin_dash;
case SPR_sonic_stop: return SPR_chaos_aqz_base_sonic_stop;
case SPR_sonic_up: return SPR_chaos_aqz_base_sonic_up;
case SPR_sonic_wait: return SPR_chaos_aqz_base_sonic_wait;
case SPR_sonic_walk: return SPR_chaos_aqz_base_sonic_walk;
case SPR_sonic_water_air: return SPR_chaos_aqz_base_sonic_water_air;
