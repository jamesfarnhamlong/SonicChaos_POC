/// @description  Sprite

image_speed = 0.25;

// THZ1 rings are terrain-quadrant adapters, not generic mapped objects.
// Existing room coordinates are canonical quadrant centres and never move.
chaosQuadrantLeft = x-8;
chaosQuadrantTop = y-8;
chaosQuadrantRight = chaosQuadrantLeft+15;
chaosQuadrantBottom = chaosQuadrantTop+15;
chaosTHZFrame = 0;

